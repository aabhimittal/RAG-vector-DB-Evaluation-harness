# Copy to .env and fill in to use real Claude models.
# Without a key, the harness runs in offline "mock" mode automatically.

# Enables real Claude API calls when RAG_LLM_MODE=auto (the default).
ANTHROPIC_API_KEY=

# --- Optional overrides (defaults shown) ---------------------------------
# RAG_LLM_MODE=auto            # auto | api | mock
# RAG_EMBEDDING_PROVIDER=hashing
# RAG_EMBEDDING_DIM=256
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=80
# RAG_TOP_K=4
# RAG_MAX_TOKENS=1024

# --- Model routing (token optimisation) ----------------------------------
# RAG_ENABLE_ROUTING=true
# RAG_SIMPLE_THRESHOLD=0.33
# RAG_MODERATE_THRESHOLD=0.66
# RAG_MODEL_SIMPLE=claude-haiku-4-5
# RAG_MODEL_MODERATE=claude-sonnet-5
# RAG_MODEL_COMPLEX=claude-opus-4-8
# RAG_MODEL_DEFAULT=claude-sonnet-5
